# Local-only defaults used by compose.yaml and the normal backend profile.
# Override these values in an untracked .env when needed.
BIZLAMA_DB_NAME=bizlama
BIZLAMA_DB_USER=bizlama
BIZLAMA_DB_PASSWORD=bizlama-local
BIZLAMA_POSTGRES_PORT=5432
BIZLAMA_APP_PORT=8080

# H2 is only an explicit, non-persistent fallback. Do not enable it when
# validating PostgreSQL migrations, constraints, locking, or restart behavior.
# SPRING_PROFILES_ACTIVE=memory

# Optional local workspace, receipt, and authentication overrides.
BIZLAMA_KITCHEN_ID=kitchen-default
BIZLAMA_LOCATION_ID=location-main
BIZLAMA_TIME_ZONE=Asia/Kolkata
BIZLAMA_RECEIPT_STORAGE=local
BIZLAMA_RECEIPT_DIRECTORY=./.data/receipts
BIZLAMA_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
BIZLAMA_VERTEX_AI_ENABLED=false
BIZLAMA_VERTEX_MODEL=gemini-2.5-flash
BIZLAMA_AUTH_MODE=local
BIZLAMA_OWNER_EMAIL=owner@bizlama.local
BIZLAMA_OWNER_NAME=Madhu
BIZLAMA_OWNER_PASSWORD=bizlama-demo
BIZLAMA_AUTH_TOKEN_SECRET=dev-only-change-before-any-shared-deployment

# Cloud deployment uses infra/gcp/config.example.env. deploy.sh supplies runtime
# variables and Secret Manager references; never put cloud secret values here.
